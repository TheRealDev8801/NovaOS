#!/usr/bin/env bash
# NovaOS Setup — the NovaOS first-boot experience.
#
# Offers two paths:
#   * Try NovaOS   — nothing is written; just explore the live session.
#   * Install      — a short wizard that writes an archinstall config and runs
#                    it, so a real disk layout and user account are created.
#
# Deliberately a shell script around `archinstall` rather than Calamares:
# Calamares is AUR-only, so shipping it would mean compiling a large Qt/KDE
# tree inside every ISO build. archinstall is an official Arch package.
#
# Usage:  nova-setup          (from the live session)
#         nova-setup --check  (validate the generated config without installing)
set -euo pipefail

VERSION="0.1.0"
CONF_DIR="/tmp/novaos-setup"
USER_CONF="$CONF_DIR/user_configuration.json"
CREDS_CONF="$CONF_DIR/user_credentials.json"

# ── presentation ──────────────────────────────────────────────────────────
# Nova palette (branding/nova-plasma/color-schemes/Nova.colors), as ANSI.
C_CYAN=$'\033[38;2;110;231;255m'
C_VIOLET=$'\033[38;2;167;139;250m'
C_TEXT=$'\033[38;2;232;236;248m'
C_DIM=$'\033[38;2;154;165;196m'
C_BOLD=$'\033[1m'
C_OFF=$'\033[0m'

have() { command -v "$1" >/dev/null 2>&1; }

banner() {
  printf '\n%s%s' "$C_CYAN" "$C_BOLD"
  cat <<'EOF'
   _   _                 ___  ____
  | \ | | _____   ____ _/ _ \/ ___|
  |  \| |/ _ \ \ / / _` | | | \___ \
  | |\  | (_) \ V / (_| | |_| |___) |
  |_| \_|\___/ \_/ \__,_|\___/|____/
EOF
  printf '%s%s  Setup %s%s\n\n' "$C_VIOLET" "$C_OFF" "$VERSION" "$C_OFF"
}

say()  { printf '%s%s%s\n' "$C_TEXT" "$*" "$C_OFF"; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_OFF"; }
warn() { printf '%s%s%s\n' "$C_VIOLET" "$*" "$C_OFF" >&2; }
die()  { printf '%s%s%s\n' "$C_VIOLET" "$*" "$C_OFF" >&2; exit 1; }

# Ask a question: gum if available, otherwise a plain read. Keeps the wizard
# usable even if gum failed to install.
ask() {
  local prompt="$1" default="${2:-}"
  if have gum; then
    gum input --prompt "$prompt " --value "$default" --prompt.foreground 110
  else
    local reply
    read -r -p "$prompt [${default}] " reply || true
    printf '%s' "${reply:-$default}"
  fi
}

confirm() {
  local prompt="$1"
  if have gum; then
    gum confirm "$prompt"
  else
    local reply
    read -r -p "$prompt [y/N] " reply || true
    [[ "$reply" =~ ^[Yy] ]]
  fi
}

choose() {
  local prompt="$1"; shift
  if have gum; then
    gum choose --header "$prompt" "$@"
  else
    # The menu MUST go to stderr. Every caller does `x="$(choose ...)"`, so
    # anything written to stdout is captured as the *answer*: the prompt, the
    # numbered list and the answer all end up concatenated into one string.
    # That is why the fallback menu "worked" but returned things like
    # "Not a block device: Select". Only the chosen value may touch stdout.
    say "$prompt" >&2
    local i=1
    for o in "$@"; do printf '  %d) %s\n' "$i" "$o" >&2; i=$((i+1)); done
    local n
    read -r -p "Choose [1]: " n || true
    n="${n:-1}"
    local arr=("$@")
    # Clamp: a non-numeric or out-of-range reply used to index outside the
    # array, which under `set -u` aborts the wizard with a cryptic error.
    [[ "$n" =~ ^[0-9]+$ ]] || n=1
    (( n < 1 || n > ${#arr[@]} )) && n=1
    printf '%s' "${arr[$((n-1))]}"
  fi
}

# ── what an installed NovaOS contains ─────────────────────────────────────
# The packages archinstall should install on the TARGET system. These are a
# curated subset of the live ISO's packages.x86_64: the live lists also carry
# medium-only tooling (mkinitcpio-archiso, squashfs-tools, memtest86+,
# edk2-shell, syslinux ...) that must never end up on a real install.
#
# This list exists because write_config() previously emitted "packages": [] and
# ignored the edition argument entirely, so installing NovaOS Gaming or Plasma
# produced a bare Arch system — no Plasma, no SDDM, no Steam. build.sh checks
# that every name below appears in the matching releng/novaos-*/packages.x86_64,
# so a typo fails the build instead of silently shrinking the desktop.
TARGET_COMMON=(
  base linux linux-firmware mkinitcpio
  dosfstools e2fsprogs btrfs-progs xfsprogs
  parted gptfdisk cryptsetup lvm2 nvme-cli smartmontools
  networkmanager openssh rsync sudo nano less bash-completion zsh
  qemu-guest-agent plymouth grub
)
TARGET_DESKTOP=(
  plasma-desktop kscreen kwallet kwallet-pam kwalletmanager
  kde-cli-tools kglobalacceld plasma-nm plasma-pa kdeplasma-addons
  kinfocenter ksystemstats plasma-systemmonitor ksshaskpass
  kde-gtk-config breeze-gtk
  konsole dolphin kate ark spectacle gwenview okular kcalc
  ffmpegthumbs kdegraphics-thumbnailers kdialog
  sddm
  pipewire pipewire-pulse pipewire-alsa wireplumber
  noto-fonts noto-fonts-emoji ttf-liberation
  mesa vulkan-radeon vulkan-intel vulkan-tools
  spice-vdagent xf86-video-qxl xdg-user-dirs
)
TARGET_GAMING=(
  gamemode lib32-gamemode mangohud lib32-mangohud gamescope
  steam wine winetricks
  lib32-mesa lib32-vulkan-radeon lib32-vulkan-intel
)
TARGET_SERVER=(
  docker podman buildah skopeo
)

# UEFI or legacy BIOS? systemd-boot only exists on UEFI, and GRUB on a GPT
# disk needs a BIOS-boot partition that archinstall's config schema cannot
# describe, so the two modes need genuinely different install steps.
firmware_mode() {
  # NOVAOS_FW is a test hook: it lets the build check both layouts in a
  # container, which has no /sys/firmware/efi to detect.
  if [[ -n "${NOVAOS_FW:-}" ]]; then
    printf '%s' "$NOVAOS_FW"
    return 0
  fi
  if [[ -d /sys/firmware/efi ]]; then
    printf 'uefi'
  else
    printf 'bios'
  fi
}

# Which ISO are we running on? Prefer the marker the profiles ship, and fall
# back to detection so an ISO built before the marker existed still installs
# the right thing.
edition_of() {
  local ed=""
  if [[ -r /etc/novaos-release ]]; then
    ed="$(sed -n 's/^EDITION="\{0,1\}\([a-z]*\)"\{0,1\}$/\1/p' /etc/novaos-release | head -n1)"
  fi
  if [[ -z "$ed" ]]; then
    if [[ -x /usr/bin/steam ]]; then
      ed="gaming"
    elif [[ -x /usr/bin/plasmashell ]]; then
      ed="plasma"
    else
      ed="server"
    fi
  fi
  printf '%s' "$ed"
}

# Print the target package list, one per line. "desktop" is accepted as an
# alias so `nova-setup --check` can validate without guessing an edition.
target_packages() {
  case "$1" in
    desktop|plasma)
      printf '%s\n' "${TARGET_COMMON[@]}" "${TARGET_DESKTOP[@]}" ;;
    gaming)
      printf '%s\n' "${TARGET_COMMON[@]}" "${TARGET_DESKTOP[@]}" "${TARGET_GAMING[@]}" ;;
    server)
      printf '%s\n' "${TARGET_COMMON[@]}" "${TARGET_SERVER[@]}" ;;
    *)
      die "unknown edition: $1" ;;
  esac
}

# archinstall starts by syncing the package database. Every NovaOS ISO shipped
# with all 425 mirrors in /etc/pacman.d/mirrorlist commented out, because the
# archiso hook that uncomments them was missing from the profiles — so the sync
# failed and the install died in two seconds with "Failed to sync Arch Linux
# package database". The profiles ship the hook now; this is the belt-and-
# braces for an ISO that predates the fix.
ensure_mirrors() {
  local ml="/etc/pacman.d/mirrorlist"
  if [[ -r "$ml" ]] && grep -q '^Server' "$ml"; then
    return 0
  fi
  warn "No active pacman mirror found (the shipped mirrorlist has none enabled)."
  warn "Writing a known-good HTTPS mirrorlist so the install can proceed."
  mkdir -p /etc/pacman.d
  cat > "$ml" <<'EOF'
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
EOF
  pacman -Sy --noconfirm >/dev/null 2>&1 || warn "pacman -Sy still failing — check the network before installing."
}

# ── disk discovery ────────────────────────────────────────────────────────
# Only real, whole block devices: skip loop devices (the ISO itself is one),
# read-only media (the CD-ROM), and anything already mounted (the live root).
list_disks() {
  lsblk -dno NAME,TYPE,SIZE,MODEL 2>/dev/null | awk '$2=="disk" { $1=$1; print }' | while read -r name type size rest; do
    [[ "$name" == loop* ]] && continue
    [[ "$name" == sr* ]] && continue
    local dev="/dev/$name"
    # skip if any partition of it is mounted (protects the live medium)
    if lsblk -no MOUNTPOINT "$dev" 2>/dev/null | grep -qv '^$'; then
      continue
    fi
    if findmnt -rn -S "$dev" >/dev/null 2>&1; then
      continue
    fi
    printf '/dev/%s\t%s\t%s\n' "$name" "$size" "$rest"
  done
}

# ── config generation ─────────────────────────────────────────────────────
# Writes archinstall's two JSON files. Kept as a heredoc with shell
# interpolation so the values the user typed are the only variables.
write_config() {
  local disk="$1" hostname="$2" username="$3" password="$4" timezone="$5" locale="$6"
  local fs="$7" edition="$8"

  mkdir -p "$CONF_DIR"
  chmod 700 "$CONF_DIR"

  # The layout below is written against archinstall 4.5 and was checked against
  # the schema the package itself ships at
  #   /usr/lib/python3.14/site-packages/archinstall/examples/config-sample.json
  # plus the ArchConfig dataclass in lib/args.py. Field names are NOT the
  # obvious ones — a hand-written config that looks plausible is rejected
  # outright. Notes on the traps, since they cost real debugging time:
  #
  #   * bootloader is a *nested object* (bootloader_config), and the value is
  #     "Systemd-boot", not "systemd-bootctl"
  #   * audio and profile live under app_config / profile_config, not top level
  #   * locale_config needs BOTH sys_lang (bare "en_US") and sys_enc ("UTF-8")
  #   * partitions need dev_path, flags and status: "create" — omitting them
  #     fails validation rather than defaulting
  #   * swap is an object ({enabled, algorithm}), not a boolean
  #   * there is no top-level "parallel downloads"; it is
  #     pacman_config.parallel_downloads
  #
  # Note the "plymouth": "spinner" key. archinstall accepts it ONLY as one of
  # ITS OWN theme names (bgrt, fade-in, glow, script, solar, spinner, spinfinity,
  # tribar, text, details) — anything else makes it exit. We deliberately pass a
  # built-in name so archinstall does the mechanical work: it installs plymouth,
  # appends `splash quiet` to the kernel command line, inserts the plymouth
  # initramfs hook, and runs `mkinitcpio -P`. post_install() then swaps in
  # nova-starlight and rebuilds once more. Passing "nova-starlight" here would
  # be rejected, which is how an earlier build failed outright.
  #
  # After editing, run:  nova-setup --check   (valid JSON + schema)
  # `--check` invokes archinstall itself; note that a bare `--dry-run` is not
  # enough to make that non-interactive, it needs `--silent` too or it hangs.
  # See the --check block at the bottom of this file.
  local locale_lang="${locale%%.*}"   # en_US.UTF-8 -> en_US
  local locale_enc="UTF-8"
  [[ "$locale" == *.* ]] && locale_enc="${locale#*.}"

  # Build the edition's package array. archinstall installs `packages` on top of
  # the profile below, which is why the profile can stay Minimal.
  local pkg_list=() p pkg_json=""
  while IFS= read -r p; do
    [[ -n "$p" ]] && pkg_list+=("$p")
  done < <(target_packages "$edition")
  for p in "${pkg_list[@]}"; do
    pkg_json+="${pkg_json:+, }\"$p\""
  done

  # Firmware decides the bootloader and therefore the partition layout.
  # Choosing systemd-boot on a BIOS machine — which this used to do
  # unconditionally — produces an installed system that cannot boot at all.
  local fw bootloader
  fw="$(firmware_mode)"
  if [[ "$fw" == "uefi" ]]; then
    bootloader="Systemd-boot"
  else
    bootloader="No bootloader"     # GRUB is installed by post_install().
  fi

  # Both layouts are GPT.
  #   UEFI: 512 MiB ESP at /boot, then root. systemd-boot lives on the ESP.
  #   BIOS: 1 MiB BIOS-boot partition, 512 MiB /boot, then root. archinstall's
  #         GRUB step calls `grub-install --target=i386-pc`, which on GPT needs
  #         a partition typed "BIOS boot" — and its JSON schema has no way to
  #         express that flag (PartitionFlag has no BIOS_GRUB). Rather than
  #         emit a layout whose install aborts, we hand the bootloader step to
  #         post_install(), which can set the type with sgdisk and then run
  #         grub-install itself.
  local partitions_json
  if [[ "$fw" == "uefi" ]]; then
    partitions_json="$(cat <<JSON
      {
        "btrfs": [],
        "dev_path": null,
        "flags": ["boot"],
        "fs_type": "fat32",
        "mount_options": [],
        "mountpoint": "/boot",
        "obj_id": "nova-boot-0001",
        "size": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 512 },
        "start": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 1 },
        "status": "create",
        "type": "primary"
      },
      {
        "btrfs": [],
        "dev_path": null,
        "flags": [],
        "fs_type": "$fs",
        "mount_options": [],
        "mountpoint": "/",
        "obj_id": "nova-root-0002",
        "size": { "sector_size": { "unit": "B", "value": 512 }, "unit": "B", "value": 0 },
        "start": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 513 },
        "status": "create",
        "type": "primary"
      }
JSON
)"
  else
    partitions_json="$(cat <<JSON
      {
        "btrfs": [],
        "dev_path": null,
        "flags": [],
        "fs_type": null,
        "mount_options": [],
        "mountpoint": null,
        "obj_id": "nova-bios-0001",
        "size": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 1 },
        "start": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 1 },
        "status": "create",
        "type": "primary"
      },
      {
        "btrfs": [],
        "dev_path": null,
        "flags": ["boot"],
        "fs_type": "ext4",
        "mount_options": [],
        "mountpoint": "/boot",
        "obj_id": "nova-boot-0002",
        "size": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 512 },
        "start": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 2 },
        "status": "create",
        "type": "primary"
      },
      {
        "btrfs": [],
        "dev_path": null,
        "flags": [],
        "fs_type": "$fs",
        "mount_options": [],
        "mountpoint": "/",
        "obj_id": "nova-root-0003",
        "size": { "sector_size": { "unit": "B", "value": 512 }, "unit": "B", "value": 0 },
        "start": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 514 },
        "status": "create",
        "type": "primary"
      }
JSON
)"
  fi

  mkdir -p "$CONF_DIR"
  chmod 700 "$CONF_DIR"

  cat > "$USER_CONF" <<EOF
{
  "version": "2.8.6",
  "archinstall-language": "English",
  "script": "guided",
  "hostname": "$hostname",
  "kernels": ["linux"],
  "timezone": "$timezone",
  "ntp": true,
  "offline": false,
  "debug": false,
  "silent": false,
  "no_pkg_lookups": false,
  "packages": [$pkg_json],
  "swap": { "enabled": true, "algorithm": "zstd" },
  "pacman_config": { "color": false, "parallel_downloads": 5 },
  "locale_config": {
    "kb_layout": "us",
    "sys_lang": "$locale_lang",
    "sys_enc": "$locale_enc"
  },
  "bootloader_config": {
    "bootloader": "$bootloader",
    "uki": false,
    "removable": false,
    "plymouth": "spinner"
  },
  "app_config": {
    "audio_config": { "audio": "pipewire" }
  },
  "profile_config": {
    "profile": { "main": "Minimal" }
  },
  "network_config": { "type": "nm" },
  "mirror_config": { "custom_servers": [] },
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "$disk",
        "wipe": true,
        "partitions": [$partitions_json]
      }
    ]
  }
}
EOF

  # Credentials live in a separate file. archinstall hashes the password itself
  # (enc_password), and `sudo: true` is what grants wheel membership — passing
  # a "groups" list, as an earlier version of this script did, is not the schema.
  cat > "$CREDS_CONF" <<EOF
{
  "root_enc_password": "",
  "users": [
    {
      "username": "$username",
      "enc_password": "$password",
      "sudo": true
    }
  ]
}
EOF

  chmod 600 "$CREDS_CONF"
}

# systemctl-enable without needing the target root mounted in a chroot: create
# the same .wants symlink systemd would. `systemctl enable` is not usable here
# because the unit files live under the target, not the running system.
enable_unit() {
  local target="$1" unit="$2" want="$3"
  mkdir -p "$target/etc/systemd/system/${want}.wants"
  ln -sf "/usr/lib/systemd/system/${unit}" "$target/etc/systemd/system/${want}.wants/${unit}"
}

# Post-install steps: the things archinstall has no opinion about but NovaOS
# does. Runs after archinstall succeeds.
post_install() {
  local username="$1" root_mnt="$2" edition="$3" disk="$4"
  say "Applying NovaOS defaults to the new system…"

  local target="/mnt"
  [[ -d "$root_mnt" ]] && target="$root_mnt"
  local fw
  fw="$(firmware_mode)"

  # Sudo access for the wheel group — otherwise the new user cannot escalate.
  mkdir -p "$target/etc/sudoers.d"
  printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$target/etc/sudoers.d/10-wheel"
  chmod 440 "$target/etc/sudoers.d/10-wheel"

  # Bring the same Nova branding the live session uses onto the installed
  # system, so the look survives the install.
  if [[ -d "$target/etc" ]]; then
    if [[ -d /usr/share/plymouth/themes/nova-starlight ]]; then
      mkdir -p "$target/usr/share/plymouth/themes"
      rm -rf "$target/usr/share/plymouth/themes/nova-starlight"
      cp -r /usr/share/plymouth/themes/nova-starlight "$target/usr/share/plymouth/themes/"
    fi
    # Point plymouth at our theme. archinstall installed plymouth with a
    # built-in theme ("spinner") purely to get the hook, `splash quiet` and the
    # initramfs wiring in place; this is the swap to NovaOS branding.
    mkdir -p "$target/etc/plymouth"
    if [[ -f "$target/etc/plymouth/plymouthd.conf" ]] && grep -q '^\[Daemon\]' "$target/etc/plymouth/plymouthd.conf"; then
      if grep -q '^Theme=' "$target/etc/plymouth/plymouthd.conf"; then
        sed -i 's/^Theme=.*/Theme=nova-starlight/' "$target/etc/plymouth/plymouthd.conf"
      else
        sed -i '/^\[Daemon\]/a Theme=nova-starlight' "$target/etc/plymouth/plymouthd.conf"
      fi
    else
      printf '[Daemon]\nTheme=nova-starlight\nShowDelay=0\n' > "$target/etc/plymouth/plymouthd.conf"
    fi

    # Where the splash parameters go depends on the firmware.
    if [[ "$fw" == "uefi" ]]; then
      # systemd-boot: one entry file per kernel.
      local entry
      for entry in "$target"/boot/loader/entries/*.conf; do
        [[ -f "$entry" ]] || continue
        grep -q 'splash' "$entry" && continue
        sed -i '/^options /s/.*/& splash quiet loglevel=3/' "$entry" || true
      done
    else
      # BIOS: GRUB, generated below. Write the command line before mkconfig.
      mkdir -p "$target/etc/default"
      if [[ -f "$target/etc/default/grub" ]]; then
        sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="splash quiet loglevel=3"/' \
          "$target/etc/default/grub"
      else
        printf 'GRUB_CMDLINE_LINUX_DEFAULT="splash quiet loglevel=3"\n' > "$target/etc/default/grub"
      fi
    fi

    # archinstall built the initramfs while "spinner" was the theme, so the
    # image has to be regenerated for nova-starlight to actually appear.
    if have arch-chroot; then
      arch-chroot "$target" mkinitcpio -P >/dev/null 2>&1 \
        || warn "Could not rebuild the initramfs; the splash will fall back to archinstall's theme."
    fi
  fi

  # BIOS bootloader. archinstall was told "No bootloader" because its GRUB
  # path runs `grub-install --target=i386-pc`, which needs a GPT partition
  # typed "BIOS boot" — and its config schema cannot express that flag. So we
  # do it here, where sgdisk can set the type first.
  if [[ "$fw" != "uefi" ]]; then
    if ! have arch-chroot; then
      warn "arch-chroot is missing; GRUB was NOT installed and the system will not boot."
    elif [[ ! -b "$disk" ]]; then
      warn "Not a block device: $disk — skipping the GRUB install."
    else
      say "Installing the GRUB bootloader (BIOS)…"
      if have sgdisk; then
        sgdisk --typecode=1:21686148-6449-6E6F-744E-656564454649 "$disk" >/dev/null 2>&1 \
          || warn "Could not mark partition 1 as a BIOS boot partition; grub-install may fail."
      else
        warn "sgdisk is missing; hoping partition 1 is already a BIOS boot partition."
      fi
      arch-chroot "$target" grub-install --target=i386-pc --recheck "$disk" \
        || warn "grub-install failed — the installed system may not boot."
      arch-chroot "$target" grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 \
        || warn "grub-mkconfig failed; /boot/grub/grub.cfg may be missing."
    fi
  fi

  # Services. A desktop needs a display manager, and a server needs to be
  # reachable — without this the installed system boots to a bare console even
  # though every package is present.
  enable_unit "$target" NetworkManager.service multi-user.target
  if [[ "$edition" != "server" ]]; then
    # graphical.target starts whatever display-manager.service points at.
    mkdir -p "$target/etc/systemd/system"
    ln -sf /usr/lib/systemd/system/sddm.service "$target/etc/systemd/system/display-manager.service"
    enable_unit "$target" sddm.service graphical.target

    # Autologin into Plasma for the user just created.
    mkdir -p "$target/etc/sddm.conf.d"
    cat > "$target/etc/sddm.conf.d/nova.conf" <<EOF
[Autologin]
User=$username
Session=plasma
Relogin=false
EOF
  else
    enable_unit "$target" sshd.service multi-user.target
    enable_unit "$target" docker.service multi-user.target
  fi

  say "NovaOS defaults applied."
}

# ── flows ─────────────────────────────────────────────────────────────────
try_novaos() {
  banner
  say "Welcome to NovaOS."
  echo
  dim "You are running the live session — nothing has been written to any disk."
  echo
  say "Things to try:"
  dim "  • The Nova Desktop is already running."
  dim "  • Open a terminal with Konsole from the taskbar."
  dim "  • Install to disk whenever you are ready:  nova-setup"
  echo
  if have fastfetch; then fastfetch; else uname -a; fi
  echo
  dim "Press Enter to close."
  read -r _ || true
}

install_flow() {
  banner
  say "NovaOS Install"
  echo
  dim "This will erase the disk you choose. Everything on it will be lost."
  echo

  # The edition drives both the package list and the post-install wiring, so
  # resolve it once, up front, and say it out loud. It used to be declared but
  # never assigned, which silently produced an empty package list.
  local edition
  edition="$(edition_of)"
  dim "  Edition    : $edition"
  echo

  # 1. disk
  local disks
  disks="$(list_disks)"
  if [[ -z "$disks" ]]; then
    die "No installable disk found. Attach a disk (or a QEMU -drive) and retry."
  fi

  local options=()
  while IFS=$'\t' read -r dev size model; do
    options+=("$dev  ($size)  $model")
  done <<< "$disks"

  local chosen
  chosen="$(choose "Select the disk to install NovaOS on:" "${options[@]}")" || die "Cancelled."
  local disk="${chosen%% *}"

  [[ -b "$disk" ]] || die "Not a block device: $disk"

  echo
  warn "ALL DATA ON $disk WILL BE DESTROYED."
  if ! confirm "Erase $disk and install NovaOS?"; then
    die "Cancelled. Nothing was written."
  fi

  # 2. basics
  echo
  local hostname username password timezone locale fs
  hostname="$(ask "Hostname:" "novaos")"
  username="$(ask "Username:" "nova")"
  while :; do
    password="$(ask "Password for $username:" "")"
    [[ -n "$password" ]] && break
    warn "Password cannot be empty."
  done

  # timezone: offer the live session's own, which the user already chose there
  local live_tz
  live_tz="$(timedatectl show -p Timezone --value 2>/dev/null || echo UTC)"
  timezone="$(ask "Timezone:" "$live_tz")"
  locale="$(ask "System language:" "en_US.UTF-8")"

  echo
  fs="$(choose "Filesystem for the root partition:" "btrfs (recommended, snapshots)" "ext4 (simple, familiar)" || echo "btrfs")"
  fs="${fs%% *}"

  echo
  dim "  Disk       : $disk  (will be erased)"
  dim "  Hostname   : $hostname"
  dim "  User       : $username"
  dim "  Timezone   : $timezone"
  dim "  Locale     : $locale"
  dim "  Filesystem : $fs"
  echo
  if ! confirm "Begin installation?"; then
    die "Cancelled. Nothing was written."
  fi

  # 3. configure + install
  ensure_mirrors
  write_config "$disk" "$hostname" "$username" "$password" "$timezone" "$locale" "$fs" "$edition"
  say "Wrote configuration to $CONF_DIR"

  if ! have archinstall; then
    die "archinstall is not installed in this live session. Cannot continue."
  fi

  # --silent is not cosmetic. Without it archinstall ignores --config for the
  # flow and puts its full curses UI (show_menu / confirm_config) on the
  # terminal, which contradicts "progress is shown below" and cannot be
  # scripted. With --silent it logs progress to stdout and runs unattended.
  say "Running archinstall. This takes a while — progress is shown below."
  echo
  if ! archinstall --config "$USER_CONF" --creds "$CREDS_CONF" --silent; then
    die "archinstall failed. No changes were made to your bootloader; you can retry."
  fi

  # 4. post-install
  post_install "$username" "/mnt" "$edition" "$disk"

  echo
  say "Installation complete."
  dim "Remove the installation medium and reboot into NovaOS."
  if confirm "Reboot now?"; then
    systemctl reboot
  fi
}

# ── entrypoint ────────────────────────────────────────────────────────────
case "${1:-}" in
  --check)
    # Validate that the wizard can generate a config that archinstall will
    # actually accept, without touching any disk.
    #
    # Checking the JSON parses is NOT enough. A config can be perfectly valid
    # JSON and still be rejected by archinstall — wrong field name, wrong
    # nesting, wrong type. That is exactly how a "plymouth": true got as far as
    # a built ISO: archinstall wants a theme *name* there, and hard-exits on
    # anything else. So when archinstall is available we hand it the config and
    # let it do the parsing, which is the only authority that matters.
    #
    # Note CONF_DIR must be exported, not assigned: the globals above are set
    # before this case runs, so a plain assignment here would be discarded.
    tmp="$(mktemp -d)"
    export CONF_DIR="$tmp" USER_CONF="$tmp/u.json" CREDS_CONF="$tmp/c.json"
    write_config "/dev/null" "novaos" "nova" "example" "UTC" "en_US.UTF-8" "btrfs" "desktop"

    for f in "$USER_CONF" "$CREDS_CONF"; do
      python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f" \
        || die "generated invalid JSON: $f"
    done
    say "well-formed JSON: ok"
    say "  firmware  : $(firmware_mode)"
    say "  bootloader: $(sed -n 's/.*"bootloader": "\([^"]*\)".*/\1/p' "$USER_CONF" | head -n1)"
    say "  packages  : $(sed -n 's/.*"packages": \[\(.*\)\],/\1/p' "$USER_CONF" | head -n1 | tr ',' '\n' | wc -l)"

    if have archinstall; then
      # `--dry-run` is NOT a validation-only mode, and on its own it does not
      # stop archinstall from being interactive: it launches the full curses
      # TUI and spins forever, never returning. A `--check` that hangs looks
      # like work in progress rather than a failure, which is worse than one
      # that errors. --silent is the flag that actually suppresses all prompts.
      #
      # The two skip flags matter for a throwaway/containerized check: without
      # them archinstall blocks on network time and keyring WKD checks that
      # cannot succeed in a sandbox. `timeout` is the backstop — if a future
      # archinstall changes its flags again, the check must still terminate.
      #
      # Plain assignment, not `local`: this block lives in a top-level `case`,
      # not a function, and `local` outside a function is a bash error that
      # aborts the check before archinstall is ever reached.
      rc=0
      timeout 300 archinstall \
        --config "$USER_CONF" --creds "$CREDS_CONF" \
        --silent --dry-run \
        --skip-ntp --skip-wkd --skip-boot --skip-version-check --skip-wifi-check \
        >"$tmp/out" 2>&1 || rc=$?

      # 124 is `timeout`'s own exit code, i.e. archinstall never returned.
      # Distinguished from a rejection so the message is not misleading.
      if (( rc == 124 )); then
        warn "archinstall did not return within 300s (likely prompted or hung)."
        tail -20 "$tmp/out" | sed 's/^/    /' >&2
        die "nova-setup --check: TIMED OUT"
      elif (( rc != 0 )); then
        warn "archinstall REJECTED the generated config:"
        tail -20 "$tmp/out" | sed 's/^/    /' >&2
        die "nova-setup --check: FAILED"
      fi
      say "archinstall accepted the config: ok"
    else
      dim "archinstall not installed — skipped schema validation."
      dim "Install it to get the full check:  pacman -S archinstall"
    fi

    rm -rf "$tmp"
    say "nova-setup --check: OK"
    ;;
  --try)
    try_novaos
    ;;
  --install)
    install_flow
    ;;
  "" )
    banner
    say "What would you like to do?"
    echo
    choice="$(choose "Choose an option:" \
      "Try NovaOS (live session — nothing is written)" \
      "Install NovaOS to disk" \
      "Quit")" || choice="Quit"
    case "$choice" in
      Try*)     try_novaos ;;
      Install*) install_flow ;;
      *)        dim "Nothing to do." ;;
    esac
    ;;
  -h|--help)
    cat <<EOF
nova-setup — NovaOS setup

  nova-setup            interactive: try the live session or install
  nova-setup --try      describe the live session
  nova-setup --install  go straight to the installer
  nova-setup --check    validate config generation, touch no disks
EOF
    ;;
  *)
    die "unknown option: $1 (try --help)"
    ;;
esac
